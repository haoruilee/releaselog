# Copy to .env.docker for Docker Compose runs.
# Compose interpolation reads this file only when passed with:
#   docker compose --env-file .env.docker ...

COMPOSE_PROJECT_NAME=releaselog
RELEASELOG_IMAGE_TAG=local

# compose.prod.yaml defaults to APP_PORT=3000.
# compose.dev.yaml defaults to APP_PORT=3001.
# APP_PORT=3000

POSTGRES_DB=releaselog
POSTGRES_USER=releaselog
POSTGRES_PASSWORD=change-me

NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_USE_SERVER_DATA=1

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

RESEND_API_KEY=
MAIL_PROVIDER=resend
DIGEST_FROM_EMAIL="ReleaseLog <updates@example.com>"
AUTH_FROM_EMAIL="ReleaseLog <login@example.com>"
VIP_FROM_EMAIL="ReleaseLog VIP <vip@example.com>"

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=

ADMIN_EMAILS=founder@example.com
PRIVATE_FEED_SIGNING_SECRET=
CRON_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional collector integrations.
GITHUB_TOKEN=
BROWSERLESS_CONTENT_URL=
BROWSERLESS_TOKEN=
BROWSERLESS_CONCURRENT=2
BROWSERLESS_TIMEOUT=120000

# Host-side autonomous review runner. The systemd timer reads this file too.
AI_REVIEW_CLI=codex
AI_REVIEW_BATCH_LIMIT=8
AI_REVIEW_MAX_BUDGET_USD=2
AI_REVIEW_DRY_RUN=0

# Host-side autonomous /goal harness.
AI_HARNESS_PRIMARY_CLI=codex
AI_HARNESS_FALLBACK_CLI=claude
AI_HARNESS_INTENT=auto
AI_HARNESS_BATCH_LIMIT=8
AI_HARNESS_WAIT_TIMEOUT_MS=2700000
AI_HARNESS_BUSY_TIMEOUT_MS=3300000
AI_HARNESS_DRY_RUN=0
AI_HARNESS_PUBLIC_URL=https://releaselog.site
